(library
 (name astjs)
 (modules astjs)
 (libraries mo_def)
 (preprocess (pps js_of_ocaml-ppx))
)

(library
 (name common)
 (modules common)
 (libraries checkseum.ocaml mo_config pipeline idllib astjs)
 (preprocess (pps js_of_ocaml-ppx))
)

(executable
 (name moc_js)
 (modes js)
 (modules moc_js)
 (libraries common mo_config idllib)
 (preprocess (pps js_of_ocaml-ppx))
)

(executable
 (name moc_interpreter)
 (modes js)
 (modules moc_interpreter)
 (libraries common mo_config)
 (preprocess (pps js_of_ocaml-ppx))
 ; The interpreter never reaches the codegen path that performs OCaml 5
 ; effects, so the larger CPS-converted bundle is unnecessary here.
 ; Drop this override if the type-checker (or anything else common to
 ; this executable) grows effects of its own.
 (js_of_ocaml (flags (:standard \ --effects=cps) --effects=disabled))
)

(executable
 (name didc_js)
 (modes js)
 (modules didc_js)
 (libraries lib idllib lang_utils)
 (preprocess (pps js_of_ocaml-ppx))
)
