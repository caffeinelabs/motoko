// Same types — compatible with v1
actor {
  stable var x : Nat;
  stable var txt : Text;
  stable var b : Bool;
  stable var n8 : Nat8;
  stable var n16 : Nat16;
  stable var n32 : Nat32;
  stable var n64 : Nat64;
  stable var i8 : Int8;
  stable var i16 : Int16;
  stable var i32 : Int32;
  stable var i64 : Int64;
  stable var f : Float;
  stable var ch : Char;
  stable var bl : Blob;
  stable var p : Principal;
  stable var arr : [Nat];
  stable var tup : (Nat, Bool);
  stable var opt : ?Nat;
  stable var v : {#a : Nat; #b : Text; #c};
  stable var obj : {x : Nat; y : Text};
};
