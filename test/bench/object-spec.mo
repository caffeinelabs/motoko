// Benchmark: ingress/egress round-trip of an Apple Event Object
// Specifier (a non-Candid wire format) through pure-Motoko codec.
//
// Public method `go(spec : ObjectSpec) : async ObjectSpec = spec` is
// decorated with `(with encoder; decoder)` — punning shorthand that
// pairs the in-scope `encoder` and `decoder` functions with the
// parenthetical's expected fields. The framework
//   - calls `decoder(msg_arg_data)` to recover an `ObjectSpec` from
//     the raw AE-binary ingress payload,
//   - hands the result to the body (which is the identity),
//   - calls `encoder(result)` to produce the reply blob (also AE
//     binary, not Candid).
//
// Both `encoder` and `decoder` self-time and print one
// `decode_heap`/`decode_cycles`/`payload_bytes` (or encode equivalent)
// line per call. The example query is
//
//   every client's yearly income whose country is Germany
//                  and 45 <= age <= 55
//
// The //CALL ingress hex below was generated by `nix run
// .#ae-encoder` (see `nix/ae-encoder.nix`). Regenerate via the same
// command on a Mac when the catalogue evolves.
//
// Roadmap (each step a separate commit):
//   v1: type surface + builder ✓
//   v2: rename to encoder/decoder, internal timing ✓
//   v3: AE encoder/decoder bodies (this commit's *next* step)
//   v4: parenthetical wiring ← this commit
//   v5: more queries, more cycle data points

import {
  performanceCounter;
  debugPrint;
  rts_heap_size;
} = "mo:⛔";

persistent actor {

  // ───────────────────────── core types ─────────────────────────

  type CandidValue = {
    #null_;
    #bool : Bool;
    #int : Int;
    #int32 : Int32;
    #nat : Nat;
    #text : Text;
    #blob : Blob;
  };

  type Comparison = { #eq; #ne; #lt; #gt; #le; #ge };

  type BoolExpr = {
    #compare : { prop : Text; op : Comparison; value : CandidValue };
    #and_ : (BoolExpr, BoolExpr);
    #or_ : (BoolExpr, BoolExpr);
    #not_ : BoolExpr;
  };

  type KeyForm = {
    #absolutePosition : Int;
    #name : Text;
    #uniqueID : Nat;
    #property : Text;
    #range : (ObjectSpec, ObjectSpec);
    #test : BoolExpr;
  };

  type ObjectSpec = {
    #root;
    #obj : { class_ : Text; container : ObjectSpec; key : KeyForm };
  };

  // ───────────────────── example query builders ─────────────────

  // Q1: every client's yearly income whose country == "Germany"
  //     and 45 <= age <= 55. Builder kept for readability and as
  //     ground truth — the actual ingress comes from //CALL bytes.
  func _germanMidlifeClientIncome() : ObjectSpec {
    let cmp_country : BoolExpr = #compare {
      prop = "country"; op = #eq; value = #text "Germany"
    };
    let cmp_age_lo : BoolExpr = #compare {
      prop = "age"; op = #ge; value = #int32 45
    };
    let cmp_age_hi : BoolExpr = #compare {
      prop = "age"; op = #le; value = #int32 55
    };
    let predicate : BoolExpr =
      #and_ (cmp_country, #and_ (cmp_age_lo, cmp_age_hi));
    let clients : ObjectSpec = #obj {
      class_ = "client";
      container = #root;
      key = #test predicate;
    };
    #obj {
      class_ = "property";
      container = clients;
      key = #property "yearlyIncome";
    };
  };


  // ───────────────────────── codec stubs ────────────────────────
  // v3 fills in the bodies. Until then these are typed correctly so
  // the parenthetical compiles, but produce trivial values.

  func counters() : (Nat, Nat64) = (rts_heap_size(), performanceCounter(0));

  func encoder(_spec : ObjectSpec) : Blob {
    let (h0, c0) = counters();
    let wire : Blob = "" : Blob;  // TODO v3: AE compact-binary encoder.
    let (h1, c1) = counters();
    debugPrint(debug_show {
      stage = "encoder";
      heap = (h1 : Int) - h0;
      cycles = c1 - c0;
      bytes = wire.size();
    });
    wire
  };

  func decoder(_wire : Blob) : ObjectSpec {
    let (h0, c0) = counters();
    let spec : ObjectSpec = #root;  // TODO v3: AE compact-binary decoder.
    let (h1, c1) = counters();
    debugPrint(debug_show {
      stage = "decoder";
      heap = (h1 : Int) - h0;
      cycles = c1 - c0;
    });
    spec
  };

  // ───────────────────────── public method ──────────────────────
  // The parenthetical pun: `(with encoder; decoder)` is sugar for
  // `(with encoder = encoder; decoder = decoder)`. The framework calls
  // `decoder` on the raw ingress bytes, then `encoder` on the reply.
  //
  // Body is the identity, so any cycles/heap reported come purely from
  // the codec round-trip — exactly what the bench wants to measure.

  (with encoder; decoder)
  public func go(spec : ObjectSpec) : async ObjectSpec { spec };
}

//CALL ingress go 

//SKIP run
//SKIP run-ir
//SKIP run-low
