import Prim "mo:⛔";

actor {
  public query func absolute(x:Int) : async Nat {
    Prim.abs x
  };
  public query func absolutes(xs:[Int]) : async [Nat] {
    Prim.Array_tabulate<Nat>(xs.size(), func (i:Nat) : Nat = Prim.abs(xs[i]))
  };
  public query func natural(n : Nat) : async Nat {
    n
  };
  public query func fromCandid() : async ?Nat {
    // 2^256
    from_candid("DIDL\00\01\7d\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\80\10")
  };
}

