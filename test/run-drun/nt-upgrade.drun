# Rows and handles survive an upgrade that keeps main memory, and writes keep working after it
install $ID nt-upgrade/tables.mo ""
ingress $ID put "DIDL\x00\x00"
ingress $ID check "DIDL\x00\x00"
upgrade $ID nt-upgrade/tables.mo ""
ingress $ID check "DIDL\x00\x00"
ingress $ID write "DIDL\x00\x00"
ingress $ID check "DIDL\x00\x00"
# Graph copy traps while a table exists, and the canister keeps working and upgrading
ingress $ID __motoko_stabilize_before_upgrade "DIDL\x00\x00"
ingress $ID check "DIDL\x00\x00"
upgrade $ID nt-upgrade/tables.mo ""
ingress $ID check "DIDL\x00\x00"
# An upgrade that changes a stable table's row type is refused, and the canister keeps working
upgrade $ID nt-upgrade/tables-row.mo ""
ingress $ID check "DIDL\x00\x00"
